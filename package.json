{
  "name": "@local/relay-dashboard",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Secure sign-in, usage dashboards, and access-token retrieval for Sub2API-compatible gateways.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "scripts/import-profile.mjs",
    "scripts/check-release.py",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check scripts/import-profile.mjs && node --test profiles.test.js",
    "check:secrets": "python3 scripts/check-release.py",
    "import:profile": "node scripts/import-profile.mjs",
    "pack:release": "npm pack --ignore-scripts --pack-destination dist"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BigYty/dsh-relay-dashboard.git"
  },
  "engines": {
    "dsh": "0.2.2-rc.1"
  }
}
